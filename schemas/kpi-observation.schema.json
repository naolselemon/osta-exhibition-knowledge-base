{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osta.example/schemas/kpi-observation.schema.json",
  "title": "KPI observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_version",
    "id",
    "system_id",
    "kpi_code",
    "measurement_scope",
    "achievement_type",
    "actual",
    "baseline",
    "target",
    "achievement",
    "reporting_period",
    "dimensions",
    "measurement_method",
    "display_value",
    "source_refs",
    "data_quality",
    "exhibition",
    "workflow",
    "publication_status",
    "verification_status",
    "data_classification",
    "contains_personal_data",
    "public_display_approved"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "record_version": {"type": "integer", "minimum": 1},
    "id": {"$ref": "#/$defs/id"},
    "system_id": {"$ref": "#/$defs/id"},
    "kpi_code": {"$ref": "#/$defs/id"},
    "measurement_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_type", "scope_id", "description"],
      "properties": {
        "scope_type": {"enum": ["system", "service", "organization", "program", "geography", "portfolio", "other"]},
        "scope_id": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "achievement_type": {"enum": ["actual", "reported-progress", "target-achievement", "milestone", "qualitative"]},
    "actual": {"$ref": "#/$defs/measurement"},
    "baseline": {"$ref": "#/$defs/measurement"},
    "target": {"$ref": "#/$defs/measurement"},
    "achievement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "value", "unit", "description"],
      "properties": {
        "status": {"enum": ["not-assessed", "below-target", "on-target", "above-target", "achieved", "reported"]},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "description": {"type": "string"}
      }
    },
    "reporting_period": {"$ref": "#/$defs/reportingPeriod"},
    "dimensions": {
      "type": "object",
      "properties": {
        "platform": {"enum": ["mobile", "web", "desktop", "api", "all", "unknown"]},
        "service_channel": {"type": "string"},
        "geography_level": {"type": "string"},
        "geography_name": {"type": "string"},
        "entity_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "aggregation_partition": {"type": "string"},
        "aggregation_weight": {"type": "number", "exclusiveMinimum": 0},
        "statistic": {"enum": ["mean", "median", "p50", "p90", "p95", "p99", "minimum", "maximum"]},
        "activity_window": {"$ref": "#/$defs/window"},
        "monitoring_period": {"$ref": "#/$defs/window"}
      },
      "additionalProperties": true
    },
    "measurement_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "description", "data_owner", "update_frequency"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "data_owner": {"type": "string", "minLength": 1},
        "update_frequency": {"type": "string", "minLength": 1}
      }
    },
    "display_value": {"type": ["string", "null"]},
    "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}},
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "accuracy_status", "duplicate_risk", "limitations"],
      "properties": {
        "completeness": {"enum": ["complete", "partial", "unknown", "needs-review", "verified", "conflicting"]},
        "accuracy_status": {"enum": ["complete", "partial", "unknown", "needs-review", "verified", "conflicting"]},
        "duplicate_risk": {"enum": ["complete", "partial", "unknown", "needs-review", "verified", "conflicting"]},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exhibition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "display_priority", "public_display_status", "chart_type", "show_reporting_date", "show_source_label"],
      "properties": {
        "headline": {"type": "boolean"},
        "display_priority": {"type": "integer", "minimum": 0},
        "public_display_status": {"enum": ["not-approved", "in-review", "approved", "withheld"]},
        "chart_type": {"enum": ["single-value", "bar", "line", "progress", "gauge", "table", "none"]},
        "show_reporting_date": {"type": "boolean"},
        "show_source_label": {"type": "boolean"}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "prepared_by_role", "reviewed_by_role", "created_at", "updated_at", "notes"],
      "properties": {
        "state": {"enum": ["draft", "needs-review", "verified", "approved", "rejected", "superseded"]},
        "prepared_by_role": {"type": "string", "minLength": 1},
        "reviewed_by_role": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date"},
        "updated_at": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      }
    },
    "publication_status": {"enum": ["draft", "in-review", "published", "archived"]},
    "verification_status": {"enum": ["needs-review", "verified", "conflicting"]},
    "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "contains_personal_data": {"type": "boolean"},
    "public_display_approved": {"type": "boolean"},
    "supersedes_observation_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "operator": {
      "enum": ["equal", "greater-than", "greater-than-or-equal", "less-than", "less-than-or-equal", "approximate", "range", "not-specified"]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value", "unit"],
      "properties": {
        "operator": {"$ref": "#/$defs/operator"},
        "value": {
          "oneOf": [
            {"type": "number"},
            {"type": "string"},
            {"type": "boolean"},
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["minimum", "maximum"],
              "properties": {
                "minimum": {"type": "number"},
                "maximum": {"type": "number"}
              }
            }
          ]
        },
        "unit": {"type": ["string", "null"]}
      }
    },
    "reportingPeriodType": {
      "enum": ["as-of-date", "day", "week", "month", "quarter", "year", "date-range", "lifetime", "unknown"]
    },
    "reportingPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start_date", "end_date", "reporting_date_text", "calendar_type"],
      "properties": {
        "type": {"$ref": "#/$defs/reportingPeriodType"},
        "start_date": {"type": ["string", "null"], "format": "date"},
        "end_date": {"type": ["string", "null"], "format": "date"},
        "reporting_date_text": {"type": ["string", "null"]},
        "calendar_type": {"enum": ["gregorian", "ethiopian", "mixed", "unknown"]}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date", "value", "unit", "description"],
      "properties": {
        "start_date": {"type": ["string", "null"], "format": "date"},
        "end_date": {"type": ["string", "null"], "format": "date"},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "description": {"type": "string"}
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "label", "path", "locator", "verification_status", "public_display_approved"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["needs-review", "verified", "conflicting"]},
        "public_display_approved": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"publication_status": {"const": "published"}}},
      "then": {
        "properties": {
          "verification_status": {"const": "verified"},
          "reporting_period": {"properties": {"type": {"not": {"const": "unknown"}}}},
          "actual": {"properties": {"unit": {"type": "string", "minLength": 1}}},
          "data_quality": {"properties": {"accuracy_status": {"not": {"const": "conflicting"}}}}
        },
        "required": ["source_refs"]
      }
    },
    {
      "if": {"properties": {"public_display_approved": {"const": true}}},
      "then": {
        "properties": {
          "data_classification": {"const": "public"},
          "contains_personal_data": {"const": false},
          "exhibition": {"properties": {"public_display_status": {"const": "approved"}}}
        }
      }
    }
  ]
}
