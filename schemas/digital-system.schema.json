{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osta.example/schemas/digital-system.schema.json",
  "title": "Digital system",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "official_name",
    "acronym",
    "category",
    "subcategories",
    "lifecycle_status",
    "publication_status",
    "organization",
    "system_classification",
    "purpose",
    "beneficiaries",
    "services_digitized",
    "integrations",
    "geographic_coverage",
    "headline_kpi_refs",
    "transformation_story_refs",
    "faq_refs",
    "media",
    "translations",
    "workflow"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "id": {"$ref": "#/$defs/id"},
    "slug": {"$ref": "#/$defs/id"},
    "official_name": {"type": "string", "minLength": 1},
    "acronym": {"type": ["string", "null"]},
    "category": {"type": "string", "minLength": 1},
    "subcategories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "lifecycle_status": {
      "enum": ["planned", "in-development", "pilot", "operational", "suspended", "retired", "unknown"]
    },
    "publication_status": {"enum": ["draft", "in-review", "published", "archived"]},
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "ownership"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "ownership": {"enum": ["owner", "operator", "shared", "unknown"]}
      }
    },
    "system_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_type", "delivery_channels", "deployment_scope"],
      "properties": {
        "primary_type": {
          "enum": [
            "mobile-application",
            "web-application",
            "platform",
            "information-system",
            "automation-system",
            "document-management-system",
            "integrated-system",
            "ai-solution",
            "other"
          ]
        },
        "delivery_channels": {
          "type": "array",
          "items": {"enum": ["web", "mobile", "desktop", "api", "kiosk", "assisted", "other"]},
          "uniqueItems": true
        },
        "deployment_scope": {"enum": ["regional", "zonal", "district", "institutional", "multi-level", "unknown"]}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "beneficiaries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "services_digitized": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "integration_type", "status", "public_display_approved"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "integration_type": {"enum": ["api", "data-exchange", "single-sign-on", "embedded", "manual", "other", "unknown"]},
          "status": {"enum": ["planned", "in-progress", "operational", "inactive", "unknown"]},
          "public_display_approved": {"type": "boolean"}
        }
      }
    },
    "geographic_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "areas", "coverage_notes"],
      "properties": {
        "levels": {"type": "array", "items": {"enum": ["regional", "zone", "city", "district", "kebele", "institution", "online", "unknown"]}, "uniqueItems": true},
        "areas": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "coverage_notes": {"type": "string"}
      }
    },
    "headline_kpi_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "transformation_story_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "faq_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "alt", "public_display_approved"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "type": {"enum": ["image", "video", "audio", "document", "link"]},
          "path": {"type": "string", "minLength": 1},
          "alt": {"type": "string"},
          "public_display_approved": {"type": "boolean"}
        }
      }
    },
    "translations": {"$ref": "#/$defs/translations"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}},
    "kpi_data_unavailable_exception": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "approved", "approved_by_role", "approval_date", "expires_on"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "approved": {"type": "boolean"},
        "approved_by_role": {"type": "string", "minLength": 1},
        "approval_date": {"type": "string", "format": "date"},
        "expires_on": {"type": ["string", "null"], "format": "date"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_version", "review_status", "created_at", "updated_at", "approved_by_role"],
      "properties": {
        "record_version": {"type": "integer", "minimum": 1},
        "review_status": {"enum": ["draft", "needs-review", "verified", "approved", "rejected"]},
        "created_at": {"type": "string", "format": "date"},
        "updated_at": {"type": "string", "format": "date"},
        "approved_by_role": {"type": ["string", "null"]}
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_name", "purpose", "approval"],
      "properties": {
        "official_name": {"type": "string"},
        "purpose": {"type": "string"},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "human_reviewed", "reviewer_role", "approved_source", "reviewed_at"],
          "properties": {
            "status": {"enum": ["draft", "needs-review", "approved", "rejected"]},
            "human_reviewed": {"type": "boolean"},
            "reviewer_role": {"type": ["string", "null"]},
            "approved_source": {"type": "boolean"},
            "reviewed_at": {"type": ["string", "null"], "format": "date"}
          }
        }
      }
    },
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "om": {"$ref": "#/$defs/translation"},
        "am": {"$ref": "#/$defs/translation"}
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "label", "path", "locator", "verification_status", "public_display_approved"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["needs-review", "verified", "conflicting"]},
        "public_display_approved": {"type": "boolean"}
      }
    }
  }
}
