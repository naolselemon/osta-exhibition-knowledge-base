      },
      "language": "am",
      "record_id": "civil-registration-dms",
      "record_type": "digital-system"
    },
    {
      "content": {
        "official_name": "የፍርድ ቤት ጉዳዮች አስተዳደርና የዐቃቤ ሕግ SIMS",
        "purpose": "የፍርድ ቤት ጉዳዮችንና የዐቃቤ ሕግ መረጃን በዲጂታል መልኩ ለማስተዳደር ይረዳል።"
      },
      "language": "am",
      "record_id": "court-case-management-prosecutor-sims",
      "record_type": "digital-system"
    },
    {
      "content": {
        "official_name": "ዲጂታል ቀበሌ መንግሥት",
        "purpose": "በቀበሌ ደረጃ የመንግሥት አገልግሎት አሰጣጥንና አስተዳደርን ዲጂታል ማድረግ።"
      },
      "language": "am",
      "record_id": "digital-kebele-government",
      "record_type": "digital-system"
    },
    {
      "content": {
        "official_name": "የማረሚያ ቤቶች አስተዳደር ስርዓት",
