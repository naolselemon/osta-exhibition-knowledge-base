      "content": {
        "official_name": "የንግድ ሥራ አውቶሜሽን",
        "purpose": "የአባላት መዝገቦችን ያደራጃል እና ተያያዥ የአስተዳደር ሥራዎችን በራስ-ሰር ያከናውናል።"
      },
      "language": "am",
      "record_id": "business-automation",
      "record_type": "digital-system"
    },
    {
      "content": {
        "official_name": "የሲቪል ምዝገባ ሰነዶች አስተዳደር ስርዓት",
