# Python bytecode and caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store

# Local logs and temporary files
*.log
*.tmp

# Local source presentations; keep authorized copies outside Git history
source-materials/presentations/*.pdf
source-materials/social-media/*.pdf
source-materials/presentations/*.pptx
releases/
